# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit text files
*.py text diff=python
*.c text diff=c
*.h text diff=c
*.md text
*.yaml text
*.yml text
*.toml text
*.json text
*.csv text
*.svg text
Makefile text

# Binary files
*.png binary
*.jpg binary
*.chd binary
*.iso binary
*.state binary
*.onnx binary
